{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusclean.local/schemas/signature-rules.v1.json",
  "title": "NexusClean Signature Rules Catalog v1",
  "description": "Declarative storage detection, 5-tier impact analysis, and cleanup strategy contract for NexusClean.",
  "type": "object",
  "required": [
    "version",
    "protectedCriticalFileNames",
    "protectedRootPaths",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "protectedCriticalFileNames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protectedRootPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signatureRule"
      }
    }
  },
  "$defs": {
    "signatureRule": {
      "type": "object",
      "required": [
        "ruleId",
        "displayName",
        "category",
        "actionType",
        "impactLevel",
        "riskScore",
        "summaryVi",
        "sideEffectIfDeleted",
        "preservedAssets"
      ],
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){1,4}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "targetPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "basePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "profileFolderRegex": {
          "type": "string",
          "minLength": 1
        },
        "allowedCacheSubfolders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extensionRoot": {
          "type": "string",
          "minLength": 3
        },
        "pruneOlderDuplicateVersions": {
          "type": "boolean"
        },
        "pruneDotUuidTempFolders": {
          "type": "boolean"
        },
        "actionType": {
          "type": "string",
          "enum": [
            "DeleteContents",
            "DeleteUnlockedItems",
            "SelectiveSubfolderPurge",
            "SemVerDuplicatePrune",
            "RecommendRelocateToSecondaryDrive",
            "RelocateOrUnregisterAdmin",
            "ResizeShadowStorageAdmin",
            "BlockedNoOp"
          ]
        },
        "impactLevel": {
          "type": "string",
          "enum": [
            "SAFE_CACHE_TIER1",
            "REBUILD_ON_DEMAND",
            "RELOCATE_TO_SECONDARY_DRIVE",
            "REQUIRES_ADMIN_ACTION",
            "PROTECTED_NEVER_DELETE"
          ]
        },
        "riskScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "requiresAdmin": {
          "type": "boolean",
          "default": false
        },
        "lockingProcesses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summaryVi": {
          "type": "string",
          "minLength": 10
        },
        "sideEffectIfDeleted": {
          "type": "string",
          "minLength": 10
        },
        "recommendedAction": {
          "type": "string",
          "minLength": 5
        },
        "preservedAssets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": ["targetPaths"]
        },
        {
          "required": ["basePaths", "profileFolderRegex", "allowedCacheSubfolders"]
        },
        {
          "required": ["extensionRoot"]
        }
      ]
    }
  }
}
