<Window x:Class="NexusClean.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexusClean v1.0 — Kiểm Toán &amp; Dọn Dẹp Ổ Đĩa Thông Minh An Toàn (Clean Architecture)"
        Width="1360"
        Height="840"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="NEXUSCLEAN • INTELLIGENT STORAGE GUARD" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                    <TextBlock Text="Bảo toàn 100% Profile trình duyệt, khóa cứng AppData gốc &amp; phân tích tác động 5 cấp độ trước khi xóa" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Ổ đĩa:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedDrive}" Width="84" VerticalContentAlignment="Center" Margin="0,0,10,0" />

                    <Button Content="🔍 Quét Ổ Đĩa" Command="{Binding ScanDriveCommand}" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Margin="0,0,8,0" />
                    <Button Content="⏹ Hủy" Command="{Binding CancelScanCommand}" Style="{StaticResource ActionButtonStyle}" Background="#475569" Margin="0,0,8,0" />
                    <Button Content="✔ Kiểm tra Rules" Command="{Binding ValidateAndReloadRulesCommand}" Style="{StaticResource ActionButtonStyle}" Background="#334155" Margin="0,0,8,0" />
                    <Button Content="🛡 Bật/Tắt Cảnh báo Đầy ổ" Command="{Binding ToggleGrowthWatcherCommand}" Style="{StaticResource ActionButtonStyle}" Background="#0F766E" Margin="0,0,8,0" />
                    <Button Content="📜 Nhật ký Audit" Command="{Binding OpenAuditLogFolderCommand}" Style="{StaticResource ActionButtonStyle}" Background="#334155" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Progress & Live Status Banner -->
        <Border Grid.Row="1" Background="#162032" CornerRadius="8" Padding="12,8" Margin="0,10,0,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusBannerText}" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Value="{Binding ScanProgressPercent}" Minimum="0" Maximum="100" Height="10" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource AccentCyanBrush}" Background="#0F172A" />
            </Grid>
        </Border>

        <!-- 3. 4 Summary KPI Cards -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TRẠNG THÁI Ổ ĐĨA HỆ THỐNG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding DriveCapacitySummary}" FontSize="15" FontWeight="Bold" Margin="0,6,0,2" TextWrapping="Wrap" />
                    <TextBlock Text="Không tải ngược OneDrive • Bỏ qua Junction" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,12" Margin="4,0,8,0" BorderBrush="#166534" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DỌN AN TOÀN NGAY (TIER 1 &amp; 2)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SafeGreenBrush}" />
                    <TextBlock Text="{Binding SafeReclaimableSummary}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SafeGreenBrush}" Margin="0,4,0,2" />
                    <TextBlock Text="Giữ 100% Login, Cookie, Bookmark &amp; Extension mới nhất" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,12" Margin="4,0,8,0" BorderBrush="#92400E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="KHUYẾN NGHỊ DỜI SANG Ổ PHỤ (TIER 3)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RelocateAmberBrush}" />
                    <TextBlock Text="{Binding RelocatableSummary}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource RelocateAmberBrush}" Margin="0,4,0,2" />
                    <TextBlock Text="Zalo Media / Pagefile — Tránh tự đầy lại ổ C:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,12" Margin="4,0,0,0" BorderBrush="#6B21A8" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="HÀNG ĐỢI QUẢN TRỊ VIÊN (TIER 4)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AdminPurpleBrush}" />
                    <TextBlock Text="{Binding AdminSummary}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AdminPurpleBrush}" Margin="0,4,0,2" />
                    <TextBlock Text="Shadow Copy (VSS) &amp; Đĩa ảo WSL2 ext4.vhdx" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 4. Master-Detail Workspace -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Categorized Findings Table -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Findings}"
                          SelectedItem="{Binding SelectedFinding}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#334155"
                          Background="#0F172A"
                          RowBackground="#1E293B"
                          AlternatingRowBackground="#172133"
                          Foreground="#F8FAFC"
                          BorderThickness="0"
                          SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderBrush" Value="#334155" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Chọn" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelectForStandardCleanup}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Danh mục" Binding="{Binding Category}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="Mục phát hiện" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Dung lượng" Binding="{Binding FormattedSize}" Width="105" IsReadOnly="True" />
                        <DataGridTextColumn Header="Cấp độ Tác động" Binding="{Binding TierBadgeLabel}" Width="215" IsReadOnly="True" />
                        <DataGridTextColumn Header="Rủi ro" Binding="{Binding RiskScore}" Width="58" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right: Vietnamese Impact Inspector & Relocation / Admin Drawer -->
            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelectedFinding, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PHÂN TÍCH MỨC ĐỘ ẢNH HƯỞNG (IMPACT INSPECTOR)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="{Binding SelectedFinding.DisplayName}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding SelectedFinding.TargetPath}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                        <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="8" Padding="12" Margin="0,12,0,8">
                            <StackPanel>
                                <TextBlock Text="1. Bản chất dữ liệu này là gì?" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                <TextBlock Text="{Binding SelectedFinding.Model.Impact.SummaryVi}" TextWrapping="Wrap" Foreground="#CBD5E1" Margin="0,4,0,10" />

                                <TextBlock Text="2. Nếu dọn dẹp sẽ ảnh hưởng gì đến máy?" FontWeight="SemiBold" Foreground="#FDE047" />
                                <TextBlock Text="{Binding SelectedFinding.Model.Impact.SideEffectIfDeleted}" TextWrapping="Wrap" Foreground="#F8FAFC" Margin="0,4,0,10" />

                                <TextBlock Text="3. Trạng thái Khóa Tiến trình (Restart Manager):" FontWeight="SemiBold" Foreground="#93C5FD" />
                                <TextBlock Text="{Binding SelectedFinding.LockStatusLabel}" TextWrapping="Wrap" Foreground="#E2E8F0" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="CAM KẾT DỮ LIỆU ĐƯỢC BẢO TOÀN 100%:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SafeGreenBrush}" Margin="0,6,0,6" />
                        <ItemsControl ItemsSource="{Binding SelectedPreservedAssets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#14532D" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding}" Foreground="#DCFCE7" TextWrapping="Wrap" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Relocation Advisor Card (Tier 3) -->
                        <Border Background="#422006" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                                BorderBrush="{StaticResource RelocateAmberBrush}" BorderThickness="1"
                                Visibility="{Binding ShowRelocationCard, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="📦 CỐ VẤN DI CHUYỂN SANG Ổ ĐĨA PHỤ (+20% ĐỆM AN TOÀN)" FontWeight="Bold" Foreground="#FCD34D" />
                                <TextBlock Text="{Binding RelocationHeaderText}" FontWeight="SemiBold" Foreground="#FEF3C7" Margin="0,6,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding RelocationSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Isolated Admin Queue Card (Tier 4) -->
                        <Border Background="#2E1065" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                                BorderBrush="{StaticResource AdminPurpleBrush}" BorderThickness="1"
                                Visibility="{Binding ShowAdminCard, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="⚡ HÀNG ĐỢI BẢO TRÌ QUYỀN QUẢN TRỊ VIÊN (UAC CÔ LẬP)" FontWeight="Bold" Foreground="#E9D5FF" />
                                <TextBlock Text="{Binding AdminActionDescription}" Foreground="#DDD6FE" TextWrapping="Wrap" Margin="0,6,0,10" FontSize="12" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Giới hạn VSS tối đa (GB &gt;= 2):" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding VssMaxGbInput}" Padding="6,4" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="WSL Distro / Đích ổ phụ:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                    <UniformGrid Grid.Column="1" Columns="2">
                                        <TextBox Text="{Binding WslDistroInput}" Padding="6,4" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding WslTargetFolderInput}" Padding="6,4" />
                                    </UniformGrid>
                                </Grid>

                                <Button Content="🛡 Thực thi qua UAC Admin Cô lập" Command="{Binding ExecuteAdminActionCommand}" Style="{StaticResource ActionButtonStyle}" Background="#7E22CE" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 5. Mandatory Two-Step Action Footer (Dry-Run -> Execute) -->
        <Border Grid.Row="4" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16,12" Margin="0,12,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="Chọn Tất cả Mục An toàn" Command="{Binding SelectAllSafeCommand}" Style="{StaticResource ActionButtonStyle}" Background="#334155" Margin="0,0,8,0" />
                    <Button Content="Bỏ chọn" Command="{Binding ClearSelectionCommand}" Style="{StaticResource ActionButtonStyle}" Background="#334155" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedSummaryText}" FontWeight="Bold" FontSize="13.5" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding LastDryRunSummary}" FontSize="11.5" Foreground="{StaticResource AccentCyanBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="🧪 Bước 1: Mô phỏng Dọn dẹp (Dry-Run)" Command="{Binding SimulateDryRunCommand}" Style="{StaticResource ActionButtonStyle}" Background="#0369A1" Margin="0,0,10,0" />
                    <Button Content="🚀 Bước 2: Thực thi Dọn dẹp An toàn" Command="{Binding ExecuteCleanupCommand}" Style="{StaticResource ActionButtonStyle}" Background="#15803D" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
