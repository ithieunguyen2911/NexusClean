<Window x:Class="NexusClean.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexusClean.UI.ViewModels"
        Title="NexusClean"
        Width="1360"
        Height="840"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Reusable Semantic Pill Badge Style driven by BadgeTone -->
        <Style x:Key="TierPillBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PillSafeBgBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Safe}">
                    <Setter Property="Background" Value="{DynamicResource PillSafeBgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Rebuild}">
                    <Setter Property="Background" Value="{DynamicResource PillRebuildBgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Relocate}">
                    <Setter Property="Background" Value="{DynamicResource PillRelocateBgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Admin}">
                    <Setter Property="Background" Value="{DynamicResource PillAdminBgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Protected}">
                    <Setter Property="Background" Value="{DynamicResource PillProtectedBgBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TierPillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PillSafeFgBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Safe}">
                    <Setter Property="Foreground" Value="{DynamicResource PillSafeFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Rebuild}">
                    <Setter Property="Foreground" Value="{DynamicResource PillRebuildFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Relocate}">
                    <Setter Property="Foreground" Value="{DynamicResource PillRelocateFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Admin}">
                    <Setter Property="Foreground" Value="{DynamicResource PillAdminFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:BadgeTone.Protected}">
                    <Setter Property="Foreground" Value="{DynamicResource PillProtectedFgBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Shell: Left Navigation Rail + Right Workspace -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT NAVIGATION RAIL ==================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <DockPanel LastChildFill="True">

                    <!-- Brand Identity -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,20">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="7"
                                Background="{DynamicResource AccentPrimaryBrush}"
                                Margin="0,0,10,0">
                            <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconHardDrive}"
                                          Stroke="{DynamicResource TextOnAccentBrush}"
                                          StrokeThickness="1.9"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NexusClean" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Quản lý dung lượng" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom System Utilities -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="4,8,4,10" />

                        <Button Command="{Binding ToggleGrowthWatcherCommand}" Style="{StaticResource UtilityRailButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconPulseWatch}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{Binding WatcherButtonLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding ValidateAndReloadRulesCommand}" Style="{StaticResource UtilityRailButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconSlidersRules}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Kiểm tra bộ quy tắc" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding OpenAuditLogFolderCommand}" Style="{StaticResource UtilityRailButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconHistoryLog}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Nhật ký hoạt động" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource UtilityRailButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconThemeContrast}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{Binding ThemeButtonLabel}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Category Filter Views -->
                    <StackPanel>
                        <TextBlock Text="Danh mục kiểm tra"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="8,0,0,8" />

                        <RadioButton GroupName="NavFilter" IsChecked="{Binding IsFilterAll}" Style="{StaticResource NavRailRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconGridAll}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.8"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Tất cả mục" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="9" Padding="7,1">
                                    <TextBlock Text="{Binding AllCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="NavFilter" IsChecked="{Binding IsFilterSafe}" Style="{StaticResource NavRailRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconShieldCheck}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Dọn an toàn" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource PillSafeBgBrush}" CornerRadius="9" Padding="7,1">
                                    <TextBlock Text="{Binding SafeCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PillSafeFgBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="NavFilter" IsChecked="{Binding IsFilterRelocate}" Style="{StaticResource NavRailRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconFolderMove}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Dời sang ổ phụ" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource PillRelocateBgBrush}" CornerRadius="9" Padding="7,1">
                                    <TextBlock Text="{Binding RelocateCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PillRelocateFgBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="NavFilter" IsChecked="{Binding IsFilterAdmin}" Style="{StaticResource NavRailRadioStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconTerminalAdmin}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Bảo trì hệ thống" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource PillAdminBgBrush}" CornerRadius="9" Padding="7,1">
                                    <TextBlock Text="{Binding AdminCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PillAdminFgBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== RIGHT WORKSPACE ==================== -->
            <Grid Grid.Column="1" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Windows 11 Proportional Storage Breakdown Card -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StorageBar.DriveTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding StorageBar.UsageHeadline}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Phân vùng:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding AvailableDrives}"
                                          SelectedItem="{Binding SelectedDrive}"
                                          Style="{StaticResource FluentComboBoxStyle}"
                                          Width="88"
                                          Margin="0,0,10,0" />

                                <Button Command="{Binding ScanDriveCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconScanRadar}"
                                                      Stroke="{DynamicResource TextOnAccentBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Quét ổ đĩa" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding CancelScanCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconStopSquare}"
                                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Dừng" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Active Scan Thin Progress Strip -->
                        <ProgressBar Value="{Binding ScanProgressPercent}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="3"
                                     BorderThickness="0"
                                     Margin="0,10,0,0"
                                     Foreground="{DynamicResource AccentPrimaryBrush}"
                                     Background="{DynamicResource BarFreeTrackBrush}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                        <!-- 5-Segment Proportional Storage Bar -->
                        <Border Height="10"
                                CornerRadius="5"
                                Background="{DynamicResource BarFreeTrackBrush}"
                                ClipToBounds="True"
                                Margin="0,12,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding StorageBar.OtherUsedWidth}" />
                                    <ColumnDefinition Width="{Binding StorageBar.SafeWidth}" />
                                    <ColumnDefinition Width="{Binding StorageBar.RelocateWidth}" />
                                    <ColumnDefinition Width="{Binding StorageBar.AdminWidth}" />
                                    <ColumnDefinition Width="{Binding StorageBar.FreeWidth}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BarOtherUsedBrush}" Margin="0,0,1,0" />
                                <Border Grid.Column="1" Background="{DynamicResource BarSafeBrush}" Margin="0,0,1,0" />
                                <Border Grid.Column="2" Background="{DynamicResource BarRelocateBrush}" Margin="0,0,1,0" />
                                <Border Grid.Column="3" Background="{DynamicResource BarAdminBrush}" Margin="0,0,1,0" />
                                <Border Grid.Column="4" Background="Transparent" />
                            </Grid>
                        </Border>

                        <!-- Interactive Legend Strip -->
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource BarOtherUsedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StorageBar.OtherUsedLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource BarSafeBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StorageBar.SafeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource BarRelocateBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StorageBar.RelocateLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource BarAdminBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StorageBar.AdminLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource BarFreeTrackBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StorageBar.FreeLabel}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Search, Quick Selection & Live Status Strip -->
                <Grid Grid.Row="1" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box with Vector Magnifier -->
                    <Grid Grid.Column="0" Width="290" Margin="0,0,10,0">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentTextBoxStyle}"
                                 Padding="30,6,10,6" />
                        <Viewbox Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconSearch}"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Tìm theo tên mục hoặc đường dẫn..."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Margin="32,0,10,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Quick Selection Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Chọn mục an toàn" Command="{Binding SelectAllSafeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                        <Button Content="Bỏ chọn" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <!-- Calm Status Line -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusBannerText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="16,0,2,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusBannerText}" />
                </Grid>

                <!-- 3. Master-Detail Workspace with Resizable GridSplitter -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.58*" MinWidth="500" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.02*" MinWidth="330" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Spacious Two-Line Findings Table -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <DataGrid ItemsSource="{Binding FindingsView}"
                                      SelectedItem="{Binding SelectedFinding}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{DynamicResource CardBgBrush}"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      ColumnHeaderStyle="{StaticResource FluentDataGridHeaderStyle}"
                                      CellStyle="{StaticResource FluentDataGridCellStyle}"
                                      RowStyle="{StaticResource FluentDataGridRowStyle}">
                                <DataGrid.Columns>
                                    <!-- Checkbox Column -->
                                    <DataGridTemplateColumn Width="46" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelectForStandardCleanup}"
                                                          Style="{StaticResource FluentCheckBoxStyle}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Two-Line Item Title + Muted Path -->
                                    <DataGridTemplateColumn Header="Mục phát hiện" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="0,2">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding TargetPath}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding TargetPath}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Category -->
                                    <DataGridTemplateColumn Header="Nhóm" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Right-Aligned Size + WizTree Proportional Mini Bar -->
                                    <DataGridTemplateColumn Header="Dung lượng" Width="116" SortMemberPath="SizeInBytes">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="92">
                                                    <TextBlock Text="{Binding FormattedSize}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Height="3.5"
                                                            Width="84"
                                                            CornerRadius="2"
                                                            Background="{DynamicResource BarFreeTrackBrush}"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,4,0,0">
                                                        <Border Height="3.5"
                                                                Width="{Binding RelativeBarWidth}"
                                                                CornerRadius="2"
                                                                HorizontalAlignment="Left"
                                                                Background="{DynamicResource AccentPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Compact Semantic Pill Badge -->
                                    <DataGridTemplateColumn Header="Khuyến nghị" Width="124">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TierPillBorderStyle}">
                                                    <TextBlock Text="{Binding ShortBadgeText}" Style="{StaticResource TierPillTextStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Calm Centered Empty State -->
                            <Border Background="{DynamicResource CardBgBrush}"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"
                                    Padding="32">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                                    <Border Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,12">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconHardDrive}"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="1.75"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding EmptyStateTitle}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding EmptyStateSubtitle}"
                                               FontSize="12.5"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Resizable Splitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="False"
                                  Cursor="SizeWE" />

                    <!-- Right: Clean Inspector Panel -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18,16">
                        <Grid>
                            <!-- Placeholder when nothing selected -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedFinding}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chọn một mục ở danh sách bên trái để xem chi tiết tác động và dữ liệu được giữ nguyên."
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="260"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <!-- Populated Inspector -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelectedFinding, Converter={StaticResource BoolToVis}}">
                                <StackPanel DataContext="{Binding}">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left" DataContext="{Binding SelectedFinding}" Style="{StaticResource TierPillBorderStyle}">
                                            <TextBlock Text="{Binding ShortBadgeText}" Style="{StaticResource TierPillTextStyle}" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding SelectedFinding.RiskSummary}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding SelectedFinding.DisplayName}"
                                               FontSize="15.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding SelectedFinding.TargetPath}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10" />

                                    <!-- Quick Path Utility Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Button Command="{Binding OpenSelectedPathCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource IconFolderOpen}"
                                                              Stroke="{DynamicResource TextPrimaryBrush}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="Mở thư mục" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding CopySelectedPathCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource IconCopy}"
                                                              Stroke="{DynamicResource TextPrimaryBrush}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="Sao chép đường dẫn" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Impact Details Box -->
                                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="13,11"
                                            Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Mô tả dữ liệu" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SelectedFinding.Model.Impact.SummaryVi}"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,10" />

                                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" />

                                            <TextBlock Text="Ảnh hưởng khi dọn" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SelectedFinding.Model.Impact.SideEffectIfDeleted}"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,10" />

                                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" />

                                            <TextBlock Text="Tiến trình đang sử dụng" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SelectedFinding.LockStatusLabel}"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Preserved Assets Section -->
                                    <TextBlock Text="Dữ liệu được giữ nguyên"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,7" />

                                    <ItemsControl ItemsSource="{Binding SelectedPreservedAssets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PillSafeBgBrush}"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Viewbox Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="{StaticResource IconCheckSimple}"
                                                                      Stroke="{DynamicResource PillSafeFgBrush}"
                                                                      StrokeThickness="2.5"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource PillSafeFgBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Tier 3: Relocation Advisor Card -->
                                    <Border Background="{DynamicResource PillRelocateBgBrush}"
                                            CornerRadius="6"
                                            Padding="13,11"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding ShowRelocationCard, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Hướng dẫn chuyển sang ổ đĩa phụ"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PillRelocateFgBrush}" />
                                            <TextBlock Text="{Binding RelocationHeaderText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,4,0,8"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding RelocationSteps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tier 4: Isolated Admin Maintenance Card -->
                                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="13,12"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding ShowAdminCard, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Bảo trì hệ thống (yêu cầu quyền Admin)"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding AdminActionDescription}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,10" />

                                            <!-- VSS Specific Input -->
                                            <Grid Margin="0,0,0,10" Visibility="{Binding IsVssAdminItem, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Giới hạn tối đa (GB):" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox Grid.Column="1" Text="{Binding VssMaxGbInput}" Style="{StaticResource FluentTextBoxStyle}" />
                                            </Grid>

                                            <!-- WSL Specific Inputs -->
                                            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsWslAdminItem, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Tên bản phân phối WSL &amp; thư mục đích:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                                <UniformGrid Columns="2">
                                                    <TextBox Text="{Binding WslDistroInput}" Style="{StaticResource FluentTextBoxStyle}" Margin="0,0,5,0" />
                                                    <TextBox Text="{Binding WslTargetFolderInput}" Style="{StaticResource FluentTextBoxStyle}" />
                                                </UniformGrid>
                                            </StackPanel>

                                            <Button Content="Chạy tác vụ với quyền Quản trị viên"
                                                    Command="{Binding ExecuteAdminActionCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. Calm Contextual Bottom Action Bar -->
                <Border Grid.Row="3"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,11"
                        Margin="0,12,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSummaryText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding LastDryRunSummary}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding SimulateDryRunCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,7"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconEyePreview}"
                                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Xem trước (Dry-Run)" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExecuteCleanupCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="16,7">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconTrashClean}"
                                                  Stroke="{DynamicResource TextOnAccentBrush}"
                                                  StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding CleanButtonLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== IN-WINDOW CONTENTDIALOG MODAL OVERLAY ==================== -->
        <Grid Panel.ZIndex="100"
              Background="{DynamicResource ModalBackdropBrush}"
              Visibility="{Binding Modal.IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22,20">
                <StackPanel>
                    <TextBlock Text="{Binding Modal.Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Text="{Binding Modal.PrimaryMessage}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,12" />

                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,18">
                        <ItemsControl ItemsSource="{Binding Modal.BulletItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="5" Height="5" CornerRadius="2.5" Background="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,7,0,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding Modal.CancelButtonText}"
                                Command="{Binding Modal.CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsCancel="True"
                                Visibility="{Binding Modal.ShowCancelButton, Converter={StaticResource BoolToVis}}"
                                Padding="16,7"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding Modal.ConfirmButtonText}"
                                Command="{Binding Modal.ConfirmCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True"
                                Padding="16,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
