<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral Graphite Dark Palette (Zero Tailwind blue-slate cast, zero neon) -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#131316" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#202024" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#27272C" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#2C2C32" />
    <SolidColorBrush x:Key="InputBgBrush" Color="#1B1B1F" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2E2E34" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#29292E" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Single Refined Accent -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoftBgBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SelectionRowBgBrush" Color="#252E42" />

    <!-- Segmented Storage Bar Colors -->
    <SolidColorBrush x:Key="BarOtherUsedBrush" Color="#52525B" />
    <SolidColorBrush x:Key="BarSafeBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="BarRelocateBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="BarAdminBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="BarFreeTrackBrush" Color="#2C2C32" />

    <!-- Semantic Soft Pill Badges -->
    <SolidColorBrush x:Key="PillSafeBgBrush" Color="#142E1F" />
    <SolidColorBrush x:Key="PillSafeFgBrush" Color="#86EFAC" />

    <SolidColorBrush x:Key="PillRebuildBgBrush" Color="#172545" />
    <SolidColorBrush x:Key="PillRebuildFgBrush" Color="#93C5FD" />

    <SolidColorBrush x:Key="PillRelocateBgBrush" Color="#33230C" />
    <SolidColorBrush x:Key="PillRelocateFgBrush" Color="#FCD34D" />

    <SolidColorBrush x:Key="PillAdminBgBrush" Color="#271B3D" />
    <SolidColorBrush x:Key="PillAdminFgBrush" Color="#D8B4FE" />

    <SolidColorBrush x:Key="PillProtectedBgBrush" Color="#381818" />
    <SolidColorBrush x:Key="PillProtectedFgBrush" Color="#FCA5A5" />

    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#9909090B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3F3F46" />

</ResourceDictionary>
